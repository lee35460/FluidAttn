{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/hooks/block-dangerous.sh\"",
            "timeout": 10,
            "statusMessage": "위험 명령 검사"
          }
        ]
      },
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/hooks/references-readonly.sh\"",
            "timeout": 5,
            "statusMessage": "references 읽기 전용"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/hooks/codex-tdd-guard.sh\"",
            "timeout": 15,
            "statusMessage": "TDD 가드 검사"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/hooks/verify-gate.sh\"",
            "timeout": 600,
            "statusMessage": "lint·build·test 게이트"
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/hooks/devlog-append.sh\"",
            "timeout": 10,
            "statusMessage": "DEVLOG"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/hooks/audit.sh\"",
            "timeout": 5,
            "statusMessage": "audit"
          }
        ]
      }
    ]
  }
}